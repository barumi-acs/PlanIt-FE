# ============================================
# 개발 환경 (Development)
# ============================================

# User Service - 사용자 프로필, 친구 관리
VITE_USER_SERVICE_URL=http://localhost:8081

# Schedule Service - 일정 및 할일 관리
VITE_SCHEDULE_SERVICE_URL=http://localhost:8082

# Intelligence Service - AI 기반 할일 생성 및 추천
VITE_INTELLIGENCE_SERVICE_URL=http://localhost:8083

# Insight Service - 통계, 리포트, 인사이트
VITE_INSIGHT_SERVICE_URL=http://localhost:8080

# ============================================
# 기타 환경 변수
# ============================================

# Gemini API Key (AI 기능 사용 시 필요)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# App URL (배포 환경에서 사용)
VITE_APP_URL=http://localhost:5173
